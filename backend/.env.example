# Copy to backend/.env and fill in real values. Never commit .env.
APP_NAME=ZebraID API
ENVIRONMENT=development
APP_VERSION=0.1.0
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Supabase -> Project Settings -> Database -> Connection string (URI).
# Session pooler (port 5432) recommended; use your DB password.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Server-side only. Never put the service role key in the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=zebra_images
# Keep equal to the bucket file_size_limit (bytes)
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_SIGNED_URL_DEFAULT_TTL=60
STORAGE_SIGNED_URL_MAX_TTL=3600

# Gemini scientific assistant (server-side only; never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# MegaDescriptor-L-384 v1 CPU recognition (store checkpoint & cache outside repo)
RECOGNITION_MODEL_PATH=
RECOGNITION_GALLERY_CACHE_PATH=
RECOGNITION_PREPROCESSING=model_card

# Comma-separated explicit origins. '*' is rejected (credentials are allowed).
CORS_ORIGINS=http://localhost:5173

# Optional: directory of authorized 3D hide scans (one sub-folder per scan with .obj/.mtl/textures).
# Served read-only to loopback clients (Vite proxy / SSH tunnel) only.
HIDE_SCANS_DIR=
