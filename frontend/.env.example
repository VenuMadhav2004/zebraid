# Frontend env vars are PUBLIC (bundled into the browser).
# Never put Supabase service-role keys or DB credentials here.

# Base URL the browser uses for API calls. "/api" goes through the Vite dev proxy.
VITE_API_BASE_URL=/api
# Where the Vite dev proxy forwards /api requests (dev server only).
VITE_PROXY_TARGET=http://127.0.0.1:8000
